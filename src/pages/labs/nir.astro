---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExecutionOrigin from '../../components/ExecutionOrigin.astro';
import projectionText from '../../data/nir/lif-readout-example.v1.inspection.json?raw';
import { NIR_STATIC_STATUS } from '../../runtime/enhance-nir';
import {
  NIR_INSPECTION_FORMAT,
  NIR_INSPECTION_VERSION,
  formatNirFieldValues,
  formatNirShape,
  layoutNirDiagram,
  nirNodeAnchorId,
  type NirFieldView,
  type NirInspectionProjection,
} from '../../runtime/nir-inspection';
import { PORTFOLIO_DEFAULT_REF, PORTFOLIO_REPOSITORY_URL } from '../../native-evidence/view';
import '../../styles/labs.css';
import '../../styles/nir-lab.css';

// The committed projection is generated by `nir-rs` from the envelope below
// (see crates/neuromorphic-adapter/tests/nir_example.rs); the browser checks
// that its own Rust/WASM parse is byte-identical before enabling inspection.
const ENVELOPE_URL = '/nir/lif-readout-example.v1.json';
const projection = JSON.parse(projectionText) as NirInspectionProjection;
if (projection.format !== NIR_INSPECTION_FORMAT || projection.format_version !== NIR_INSPECTION_VERSION) {
  throw new Error('Unsupported NIR inspection projection; regenerate it with the adapter crate.');
}
const layout = layoutNirDiagram(projection);
const embeddedProjection = JSON.stringify(projectionText).replaceAll('<', '\\u003c');
const generatorUrl = `${PORTFOLIO_REPOSITORY_URL}/blob/${PORTFOLIO_DEFAULT_REF}/${projection.asset.generator}`;
const handAuthored = projection.asset.origin === 'hand-authored-example';
const fieldShape = (field: NirFieldView) => (field.kind === 'absent' ? '—' : formatNirShape(field.shape));
---
<BaseLayout title="NIR network inspection" description="A small, hand-authored NIR graph parsed and validated by nir-rs in Rust/WASM. Imported graph structure only; nothing is simulated.">
  <section class="page-intro compact" aria-labelledby="nir-title">
    <p class="eyebrow">Labs · NIR</p>
    <h1 id="nir-title">Inspecting a NIR graph.</h1>
    <p>The Neuromorphic Intermediate Representation (NIR) is a framework-neutral graph format for spiking neural networks. This lab reads one small example graph with <a href="https://github.com/Limen-Neural/nir-rs" target="_blank" rel="noreferrer">nir-rs</a>, a pure-Rust NIR implementation, compiled to WebAssembly without its native HDF5 reader.</p>
  </section>

  <section class="nir-lab" aria-labelledby="nir-graph-title" data-nir-lab data-nir-envelope={ENVELOPE_URL} data-nir-state="static">
    <div class="nir-lab-heading">
      <div>
        <ExecutionOrigin origin="imported-nir" />
        <h2 id="nir-graph-title">{projection.asset.title}</h2>
        <p class="nir-lab-copy">This is imported graph structure, not a simulation. Nothing on this page runs neurons or produces spikes. The live Rust/WASM simulation on the <a href="/">homepage</a> is a different network, built by synaptic-wiring and advanced by neuromod.</p>
      </div>
      <dl class="nir-provenance">
        <div>
          <dt>Example</dt>
          <dd>{projection.asset.summary}</dd>
        </div>
        <div>
          <dt>Origin</dt>
          <dd data-nir-asset-origin={projection.asset.origin}>{handAuthored ? 'Hand-authored with the nir-rs graph API. Not trained, tuned, or measured.' : projection.asset.origin}</dd>
        </div>
        <div>
          <dt>Parsed by</dt>
          <dd>nir-rs {projection.nir_rs_version} with only its <code>serde</code> feature. The native <code>hdf5</code> feature is not in the browser build.</dd>
        </div>
        <div>
          <dt>Asset</dt>
          <dd><a href={ENVELOPE_URL}>{ENVELOPE_URL.split('/').at(-1)}</a> · revision {projection.asset.revision}</dd>
        </div>
        <div>
          <dt>Generator</dt>
          <dd><a href={generatorUrl} target="_blank" rel="noreferrer">{projection.asset.generator}</a></dd>
        </div>
        <div>
          <dt>Regenerate</dt>
          <dd><code>{projection.asset.regenerate}</code></dd>
        </div>
        {projection.nir_version ? (
          <div>
            <dt>NIR version</dt>
            <dd>{projection.nir_version}</dd>
          </div>
        ) : null}
      </dl>
    </div>

    <div class="nir-stage">
      <figure class="nir-diagram" data-nir-diagram>
        <svg viewBox={`0 0 ${layout.width} ${layout.height}`} width={layout.width} height={layout.height} aria-labelledby="nir-diagram-title nir-diagram-desc">
          <title id="nir-diagram-title">NIR graph: {projection.asset.title}</title>
          <desc id="nir-diagram-desc">{layout.nodes.length} operators joined by {layout.edges.length} directed edges, from the input at the top to the output at the bottom. Each operator links to its details.</desc>
          <defs>
            <marker id="nir-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0L8 4L0 8z" fill="currentColor" />
            </marker>
          </defs>
          <g class="nir-edges" fill="none">
            {layout.edges.map((edge) => (
              <path d={edge.path} marker-end="url(#nir-arrow)" data-nir-edge-source={edge.source} data-nir-edge-target={edge.target} />
            ))}
          </g>
          <g class="nir-nodes">
            {layout.nodes.map((node) => (
              <a href={`#${node.anchorId}`} class="nir-node" data-nir-node={node.name} data-nir-operator={node.operator} aria-label={`${node.name}, ${node.operator} operator`}>
                <rect x={node.x} y={node.y} width={node.width} height={node.height} rx="6" />
                <text class="nir-node-name" x={node.x + 14} y={node.y + 23}>{node.name}</text>
                <text class="nir-node-summary" x={node.x + 14} y={node.y + 42}>{node.summary}</text>
              </a>
            ))}
          </g>
        </svg>
        <figcaption>Layers run top to bottom. Each box is one NIR operator; its second line is the operator type and its first field.</figcaption>
      </figure>

      <div class="nir-side">
        <p class="nir-status" data-nir-status role="status" aria-live="polite">{NIR_STATIC_STATUS}</p>
        <noscript>
          <p class="nir-status">JavaScript is off, so each operator in the diagram links to its entry in the list below. That list comes from the same nir-rs projection.</p>
        </noscript>
        <aside class="nir-inspector" data-nir-inspector aria-label="Operator inspector" hidden>
          <p class="nir-selection" data-nir-selection aria-live="polite"></p>
          <div data-nir-inspector-body></div>
        </aside>
        <div class="nir-edge-summary">
          <p class="eyebrow">Edges</p>
          <ol>
            {projection.edges.map((edge) => (
              <li><code>{edge.source}</code> <span aria-hidden="true">→</span><span class="visually-hidden">to</span> <code>{edge.target}</code></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
    <script is:inline type="application/json" data-nir-static-projection set:html={embeddedProjection}></script>
  </section>

  <section class="nir-operators" aria-labelledby="nir-operators-title">
    <div class="nir-operators-heading">
      <p class="eyebrow">Operators</p>
      <h2 id="nir-operators-title">Every operator, as nir-rs reads it.</h2>
      <p>Rendered at build time from the committed nir-rs projection. Field names are NIR wire names, and every value is formatted in Rust and shown as is.</p>
    </div>
    <ol class="nir-operator-list">
      {projection.nodes.map((node) => (
        <li id={nirNodeAnchorId(node.name)} class="nir-operator" data-nir-operator-entry={node.name}>
          <header>
            <h3>{node.name}</h3>
            <p><code>{node.operator}</code></p>
          </header>
          <dl class="nir-links">
            <div>
              <dt>Receives from</dt>
              <dd>{node.inputs.length > 0 ? node.inputs.join(', ') : 'none'}</dd>
            </div>
            <div>
              <dt>Sends to</dt>
              <dd>{node.outputs.length > 0 ? node.outputs.join(', ') : 'none'}</dd>
            </div>
          </dl>
          {[
            { caption: 'Parameters', fields: node.parameters },
            { caption: 'Metadata', fields: node.metadata },
          ].filter((table) => table.fields.length > 0).map((table) => (
            <div class="nir-table-wrap">
              <table class="nir-field-table">
                <caption>{table.caption}</caption>
                <thead>
                  <tr>
                    <th scope="col">Field</th>
                    <th scope="col">dtype</th>
                    <th scope="col">Shape</th>
                    <th scope="col">Values</th>
                  </tr>
                </thead>
                <tbody>
                  {table.fields.map((field) => (
                    <tr>
                      <th scope="row"><code>{field.name}</code></th>
                      <td>{field.dtype ?? '—'}</td>
                      <td>{fieldShape(field)}</td>
                      <td class="nir-field-values">{formatNirFieldValues(field)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
<script>
  import { enhanceNirLabs } from '../../runtime/enhance-nir';
  try {
    enhanceNirLabs();
  } catch {
    // Keep the static diagram and operator list available.
  }
</script>
