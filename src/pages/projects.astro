---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="Projects" description="Selected AI/ML systems engineering projects and research explorations."><section class="page-intro compact" aria-labelledby="projects-title"><p class="eyebrow">Projects</p><h1 id="projects-title">A working set of systems investigations.</h1><p>Each entry is deliberately modest: project scope and methods first, claims only when there is evidence to support them.</p></section><section class="project-grid full-grid" aria-label="Projects">{projects.map((project) => <ProjectCard project={project} />)}</section><aside class="placeholder-callout"><strong>Maintainer note.</strong> Add a repository, case study, or demo URL to each project in <code>src/data/projects.ts</code> when it is ready to be public.</aside></BaseLayout>
