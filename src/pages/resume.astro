---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Résumé"><section class="resume-panel" aria-labelledby="resume-title"><p class="eyebrow">Résumé</p>{site.resumePath ? <><h1 id="resume-title">Experience, in brief.</h1><p>The résumé is available as a PDF.</p><a class="button button-primary" href={site.resumePath}>Download résumé <span aria-hidden="true">↓</span></a></> : <><h1 id="resume-title">Résumé unavailable.</h1><p>No public résumé has been added to this site. The selected work and public profiles provide the current overview.</p><a class="button button-secondary" href="/work/">View selected work <span aria-hidden="true">→</span></a></>}</section></BaseLayout>
