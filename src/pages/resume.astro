---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Résumé"><section class="resume-panel" aria-labelledby="resume-title"><p class="eyebrow">Résumé</p><h1 id="resume-title">A résumé, when it is ready.</h1><p>Place your final PDF at <code>public/resume.pdf</code>. This page will then expose it as a live link—without inventing professional history here.</p>{site.resumePath ? <a class="button button-primary" href={site.resumePath}>Download résumé <span aria-hidden="true">↓</span></a> : <span class="button button-primary disabled-link" aria-disabled="true">Add résumé PDF to enable <span aria-hidden="true">↓</span></span>}<p class="small-note">Placeholder: add <code>public/resume.pdf</code> and set <code>resumePath</code> before publishing.</p></section></BaseLayout>
