---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout title="Notes" description="Technical notes from an AI/ML systems engineering practice."><section class="page-intro compact" aria-labelledby="notes-title"><p class="eyebrow">Writing / notes</p><h1 id="notes-title">Notes in progress.</h1><p>Short, practical field notes on systems work, research practice, and reproducibility.</p></section><div class="note-list">{notes.map((note) => <article class="note-entry"><div><p class="eyebrow">Note · {note.data.published.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</p><h2><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2></div><p>{note.data.description}</p><a class="text-link" href={`/notes/${note.id}/`}>Read note <span aria-hidden="true">→</span></a></article>)}</div></BaseLayout>
