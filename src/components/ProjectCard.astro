---
import type { Project } from '../data/projects';
const { project, index } = Astro.props as { project: Project; index: number };
---
<article class="project-card">
  <div class="project-topline"><span class="status"><i aria-hidden="true"></i>{project.status}</span><span>{String(index + 1).padStart(2, '0')}</span></div>
  <p class="project-category">{project.category}</p>
  <h3><a href={`/work/#${project.slug}`}>{project.name}</a></h3><p>{project.summary}</p>
  <ul class="technology-list" aria-label={`${project.name} technologies`}>{project.technologies.map((technology) => <li>{technology}</li>)}</ul>
  <a class="project-detail-link" href={`/work/#${project.slug}`}>Read the project brief <span aria-hidden="true">→</span></a>
</article>
