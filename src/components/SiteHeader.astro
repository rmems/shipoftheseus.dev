---
import SignalMark from './SignalMark.astro';
import { navigation, site } from '../data/site';
const { currentPath = '' } = Astro.props;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---
<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name} home`}><SignalMark /><span>Ship of Theseus</span></a>
  <nav class="primary-nav" aria-label="Primary navigation">{navigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
  <a class="header-profile" href={site.social.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
</header>
