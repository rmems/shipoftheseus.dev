---
import { executionOriginData, executionOriginLabel, type ExecutionOrigin } from '../native-evidence/view';

interface Props {
  origin: ExecutionOrigin;
  runtimeBound?: boolean;
}

const { origin, runtimeBound = false } = Astro.props;
const label = executionOriginLabel(origin);
const dataOrigin = executionOriginData(origin);
---
<p class="execution-origin" data-origin={dataOrigin} data-demo-origin={runtimeBound ? true : undefined}>{label}</p>
